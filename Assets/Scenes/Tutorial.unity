--- !u!114 &635954414
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 635954412}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Game c\xF3 l\u1ED1i ch\u01A1i xoay quanh vi\u1EC7c ng\u01B0\u1EDDi ch\u01A1i
    ph\u1EA3i t\xECm ch\xECa kh\xF3a \u0111\u1EC3 m\u1EDF c\u1EEDa qua c\xE1c level
    c\u1EE7a m\xEA cung, thu th\u1EADp xu \u0111\u1EC3 mua v\u0169 kh\xED v\xE0 \u0111\u1EA1o
    c\u1EE5, tr\xE1nh ho\u1EB7c ti\xEAu di\u1EC7t qu\xE1i v\u1EADt. M\u1ED7i level
    c\xF3 \u0111\u1ED9 kh\xF3 t\u0103ng d\u1EA7n v\xE0 c\xE1c th\u1EED th\xE1ch kh\xE1c
    nhau. Ng\u01B0\u1EDDi ch\u01A1i s\u1EBD b\u1EAFt \u0111\u1EA7u t\u1EEB level
    1, t\xECm ch\xECa kh\xF3a, s\u1EED d\u1EE5ng n\xF3 \u0111\u1EC3 qua c\u1EEDa
    v\xE0 ti\u1EBFp t\u1EE5c qua c\xE1c level ti\u1EBFp theo. Sau khi thu th\u1EADp
    v\xE0ng, ng\u01B0\u1EDDi ch\u01A1i c\xF3 th\u1EC3 mua \u0111\u1EA1o c\u1EE5 ho\u1EB7c
    ch\u1EC9 d\u1EABn \u0111\u1EC3 h\u1ED7 tr\u1EE3. N\u1EBFu b\u1ECB qu\xE1i v\u1EADt
    t\u1EA5n c\xF4ng, ng\u01B0\u1EDDi ch\u01A1i m\u1EA5t m\xE1u v\xE0 c\xF3 th\u1EC3
    quay l\u1EA1i c\xE1c level tr\u01B0\u1EDBc nh\u01B0ng s\u1EBD b\u1ECB tr\u1EEB
    m\xE1u. M\u1EE5c ti\xEAu cu\u1ED1i c\xF9ng l\xE0 \u0111\xE1nh b\u1EA1i boss cu\u1ED1i
    \u0111\u1EC3 t\xECm kho b\xE1u v\xE0 chi\u1EBFn th\u1EAFng. Game c\xF3 c\u01A1
    ch\u1EBF kh\xF4ng c\xF3 ch\u1EBF \u0111\u1ED9 l\u01B0u, v\xE0 k\u1EBFt th\xFAc
    game s\u1EBD hi\u1EC3n th\u1ECB x\u1EBFp h\u1EA1ng c\u1EE7a ng\u01B0\u1EDDi ch\u01A1i."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: f5d61af5752472f42ba0bc04f1b8c2c9, type: 2}
